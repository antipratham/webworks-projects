# Copy to .env and fill in. `.env` is gitignored; this file is not, so it holds no values.
#   node --env-file=.env serve.ts

# ---- language model -------------------------------------------------------------
# Local vLLM (the deployment target). Both lines can be left out - these are defaults.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8

# Gemini, for testing before a GPU exists. Uncomment all three.
# Free-tier model names move: Google retires them for new accounts (404, with the
# replacement named in the message) and the flagship ones return 503 under load.
# List what your key can actually reach:
#   curl -s https://generativelanguage.googleapis.com/v1beta/openai/models #        -H "Authorization: Bearer $LLM_API_KEY"
# gemini-3.5-flash-lite was the reliable one on 2026-10-28; the larger flash models
# were intermittently 503.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=

# ---- retrieval ------------------------------------------------------------------
# Embedding endpoint for hybrid search. services/embed/server.py serves this on CPU.
# EMBED_BASE_URL=http://127.0.0.1:8001/v1
# EMBED_MODEL=intfloat/multilingual-e5-small

# ---- speech out (reading the answer aloud) --------------------------------------
# Indic Parler-TTS. Without it the console uses the browser's own voice.
# TTS_BASE_URL=http://127.0.0.1:8020

# ---- speech in (the microphone in the console) ----------------------------------
# Self-hosted Whisper, OpenAI-compatible. This is the deployment target: set it and
# the Gemini stand-in below is never used.
# STT_BASE_URL=http://127.0.0.1:8010/v1
# STT_MODEL=Systran/faster-whisper-large-v3

# With no STT_BASE_URL, a Gemini key already set above is reused for transcription
# through the native API - gemini-3.5-flash-lite handles audio and was verified on
# 2026-10-29. STT_PROVIDER=off hides the microphone entirely.
# STT_PROVIDER=gemini
# STT_API_KEY=
# STT_MODEL=gemini-3.5-flash-lite
