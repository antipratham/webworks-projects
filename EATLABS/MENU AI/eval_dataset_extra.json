{
  "schema_version": "1.0",
  "description": "Supplementary eval cases for situations the primary dataset does not reach: section spread vs a named course, light/heavy, party size, abusive language, out-of-scope requests, and requirements the taxonomy cannot express. Same shape as eval_dataset.json, so the same scorer runs over it. Extension fields (weight, party_size, request_kind) are scored only where declared.",
  "menu_reference": "menu_database_200items.json",
  "queries": [
    {
      "id": "S001",
      "category": "sections",
      "query": "give me spicy food",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {
          "spicy": "high"
        },
        "sort_by": null,
        "max_price_paise": null
      },
      "expected_match_type": "exact",
      "notes": "No course named, so the answer must span sections - spicy exists in starters, soups, mains and drinks. Spice is a basic taste with a level, not a yes/no note."
    },
    {
      "id": "S002",
      "category": "sections",
      "query": "show me a spicy main course",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": "main",
        "taste_preferences": {
          "spicy": "high"
        },
        "sort_by": null,
        "max_price_paise": null
      },
      "expected_match_type": "exact",
      "notes": "Course named, so one section only. Same taste filter as S001; only the spread differs. Spice is a basic taste with a level, not a yes/no note."
    },
    {
      "id": "S003",
      "category": "sections",
      "query": "anything spicy in the starters?",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": "starter",
        "taste_preferences": {
          "spicy": "high"
        },
        "sort_by": null,
        "max_price_paise": null
      },
      "expected_match_type": "exact",
      "notes": "\"in the starters\" pins the course even though it is phrased as a location. Spice is a basic taste with a level, not a yes/no note."
    },
    {
      "id": "S004",
      "category": "sections",
      "query": "show me everything creamy",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {
          "sweet_creamy": true
        },
        "sort_by": null,
        "max_price_paise": null
      },
      "expected_match_type": "exact",
      "notes": "\"everything\" is not a licence to dump the menu - it still returns a sectioned shortlist."
    },
    {
      "id": "W001",
      "category": "weight",
      "query": "something light",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": null,
        "weight": "light"
      },
      "expected_match_type": "exact",
      "notes": "With no course named, light means the lighter courses too - soups, salads, drinks, starters."
    },
    {
      "id": "W002",
      "category": "weight",
      "query": "a light main course",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": "main",
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": null,
        "weight": "light"
      },
      "expected_match_type": "exact",
      "notes": "A named course makes light relative to that course - the lighter mains, not nothing at all."
    },
    {
      "id": "W003",
      "category": "weight",
      "query": "something heavy and filling",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": null,
        "weight": "heavy"
      },
      "expected_match_type": "exact",
      "notes": "\"filling\" is the same signal as \"heavy\"; it must not become a taste."
    },
    {
      "id": "W004",
      "category": "weight",
      "query": "nothing too heavy please",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": null,
        "weight": "light"
      },
      "expected_match_type": "exact",
      "notes": "Negated heavy is light. The trap is emitting weight heavy from the word \"heavy\"."
    },
    {
      "id": "W005",
      "category": "weight",
      "query": "a light vegetarian starter",
      "expected_filter": {
        "dietary_include": [
          "veg"
        ],
        "dietary_exclude": [],
        "course": "starter",
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": null,
        "weight": "light"
      },
      "expected_match_type": "exact",
      "notes": "Weight, course and diet at once."
    },
    {
