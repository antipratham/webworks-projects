    {
      "id": "C001",
      "category": "compound",
      "query": "light vegan starter under 200",
      "expected_filter": {
        "dietary_include": [
          "vegan"
        ],
        "dietary_exclude": [],
        "course": "starter",
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": 20000,
        "weight": "light"
      },
      "expected_match_type": "relaxed",
      "notes": "Four constraints at once, one of them an extension field. This menu has no vegan starters at all, so the exact filter matches nothing and the ladder relaxes down to the nearest real dishes - with vegan still enforced."
    },
    {
      "id": "C002",
      "category": "compound",
      "query": "spicy non-veg main for 3, nothing over 400",
      "expected_filter": {
