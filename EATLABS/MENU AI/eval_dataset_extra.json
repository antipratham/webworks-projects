    {
      "id": "P004",
      "category": "party_size",
      "query": "dinner for 6, nothing too spicy",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {
          "spicy": "low"
