    },
    {
      "id": "P005",
      "category": "party_size",
      "query": "just for me, something spicy",
      "expected_filter": {
        "dietary_include": [],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {
          "spicy": "high"
        },
        "sort_by": null,
        "max_price_paise": null,
        "party_size": 1
      },
      "expected_match_type": "exact",
      "notes": "\"just for me\" is a party of one, not an absent party size. Spice is a basic taste with a level, not a yes/no note."
    },
    {
      "id": "A001",
      "category": "abusive",
