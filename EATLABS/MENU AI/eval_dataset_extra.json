    {
      "id": "V001",
      "category": "dietary",
      "query": "show me something spicy in veg",
      "expected_filter": {
        "dietary_include": [
          "veg"
        ],
        "dietary_exclude": [],
        "course": null,
        "taste_preferences": {
          "spicy": "high"
        },
        "sort_by": null,
        "max_price_paise": null
      },
      "expected_match_type": "exact",
      "notes": "\"in veg\" is the usual phrasing on an Indian menu. A parser that only knows \"vegetarian\" drops the constraint and leaks non-veg dishes into the answer. Spice is a basic taste with a level, not a yes/no note."
    },
    {
      "id": "V002",
      "category": "dietary",
      "query": "any non-veg starters",
      "expected_filter": {
        "dietary_include": [
          "non_veg"
        ],
        "dietary_exclude": [],
        "course": "starter",
        "taste_preferences": {},
        "sort_by": null,
        "max_price_paise": null
      },
      "expected_match_type": "exact",
      "notes": "The \"non\" must be read before the \"veg\": the trap is matching veg on the tail of non-veg."
    },
    {
      "id": "V003",
