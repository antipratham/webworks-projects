# ---- runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- datastores (keep both in ap-south-1 / Mumbai: data residency rule) ----
DATABASE_URL=postgres://restoos:restoos@localhost:5432/restoos_wa
REDIS_URL=redis://localhost:6379

# ---- Meta Cloud API ----
# Graph version is pinned deliberately. Bump it as a reviewed change, never implicitly.
GRAPH_API_VERSION=v21.0
GRAPH_API_BASE=https://graph.facebook.com

# Verify token you choose; the integration owner enters the SAME string in the
# Meta app's webhook config. Not a secret Meta issues to you.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me

# App Secret for X-Hub-Signature-256 validation on inbound webhooks.
META_APP_SECRET=change-me

# ---- tenant credential encryption ----
# This key protects every tenant's WhatsApp token AND the pseudonyms that stand
# in for erased guests. Where it is read from is a production decision.
#
#   env    the value below. Fine locally and in CI. NOT fine in production:
#          environment variables leak via crash dumps, `docker inspect`,
#          process listings and CI logs.
#   file   read from SECRET_REF. How Kubernetes/ECS mount a secret. Usually right.
#   aws    AWS Secrets Manager via the Secrets Manager Agent sidecar.
#   vault  HashiCorp Vault via the Vault Agent sidecar.
SECRET_SOURCE=env
# SECRET_REF=/var/run/secrets/restoos/credentials-key
# SECRET_JSON_KEY=credentials_enc_key
# SECRET_AGENT_URL=http://localhost:2773

# Only used when SECRET_SOURCE=env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENC_KEY=

# ---- Restaurant OS callbacks ----
RESTAURANT_OS_BASE_URL=http://localhost:4000
RESTAURANT_OS_API_KEY=change-me

# NOTE: there is no shared intake key. Each tenant gets its own, minted with
# BOOTSTRAP_ADMIN_KEY below and presented as `Authorization: Bearer rok_...`.

# ---- behaviour ----
# Marketing sends outside this window are deferred to the next open hour (outlet TZ).
QUIET_HOURS_START=21
QUIET_HOURS_END=9

# ---- pacing ----
# A guest who just got a confirmation should not get a reminder an hour later.
MIN_MESSAGE_GAP_HOURS=8
MARKETING_COOLDOWN_DAYS=14
CAMPAIGN_BOOKING_EXCLUSION_HOURS=48

# ---- retention ----
RETENTION_DAYS=90
ERASURE_SLA_DAYS=7

# ---- provisioning ----
# Mints the first per-tenant API key and nothing else. Put it in a secret
# manager. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOTSTRAP_ADMIN_KEY=

# ---- observability ----
METRICS_ENABLED=true
